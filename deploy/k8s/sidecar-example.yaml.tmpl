# Example: pii-server as a localhost sidecar.
#
# The application container calls 127.0.0.1:8080 for redact/rehydrate.
# Because the sidecar only listens on loopback, no Service is needed and the
# PII service is not reachable from other pods.
#
# NOTE: Kubernetes requires the sealed key to be shared only within this pod;
# scale the app by running more pods, not more replicas of the sidecar.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pii-sidecar-example
  namespace: pii-shield
  labels:
    app.kubernetes.io/name: pii-shield
    app.kubernetes.io/component: sidecar-example
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: pii-shield
      app.kubernetes.io/component: sidecar-example
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pii-shield
        app.kubernetes.io/component: sidecar-example
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 35
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        # ---- The application (placeholder) ----
        - name: app
          image: busybox:1.36
          command: ["sh", "-c", "sleep infinity"]
          env:
            - name: PII_SIDECAR_ENDPOINT
              value: "http://127.0.0.1:8080"
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi

        # ---- pii-server bound to loopback only ----
        - name: pii-server
          image: pii-shield:local
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          env:
            - name: PII_BIND_ADDR
              value: "127.0.0.1:8080"
            - name: PII_TOKEN_FORMAT
              value: "stateless-sealed"
            - name: PII_LOG_FORMAT
              value: "json"
            - name: PII_SEAL_KEY
              valueFrom:
                secretKeyRef:
                  name: pii-server-seal-key
                  key: PII_SEAL_KEY
          ports:
            - name: http
              containerPort: 8080
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 2
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            initialDelaySeconds: 1
            periodSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
